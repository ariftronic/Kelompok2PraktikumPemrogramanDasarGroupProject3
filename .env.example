# Salin file ini menjadi .env lalu sesuaikan. File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Contoh di bawah untuk XAMPP bawaan (user root tanpa password). Untuk Aiven, isi host, port, user,
# password, dan DB_SSL_CA dari console Aiven (lihat README bagian Setup Database).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peminjaman_lab
# Path ke ca.pem bila server mewajibkan SSL (Aiven). Kosongkan untuk XAMPP.
DB_SSL_CA=
# Nama yang dicatat di tabel log_aktivitas.
NAMA_PETUGAS=Petugas Lab
